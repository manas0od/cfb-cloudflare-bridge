
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "claude-freedom-bridge",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "BRIDGE",
        "class_name": "Bridge"
      }
    ]
  },
  "exports": {
    "Bridge": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
